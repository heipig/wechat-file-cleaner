# Normalise line endings so the repo does not churn on Windows vs Unix checkouts.
* text=auto eol=lf

# PowerShell must keep CRLF: Windows PowerShell 5.1 mis-parses a .ps1 that uses
# bare LF in some constructs, and this project already hit one parser surprise.
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary assets must never be line-ending converted.
*.exe binary
*.dll binary
*.pak binary
*.dat binary
*.bin binary
*.png binary
*.ico binary
*.zip binary
*.asar binary

# Keep generated bundles out of diffs and language statistics.
dist/** linguist-generated=true
package-lock.json linguist-generated=true
